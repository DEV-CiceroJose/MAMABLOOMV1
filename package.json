{
  "name": "mamabloom-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build:app": "pnpm --dir app build",
    "build:site": "pnpm run build:app && node scripts/build-static-site.mjs",
    "test:site": "node --test scripts/*.test.mjs",
    "test:api": "pnpm --dir api test",
    "check": "pnpm --dir api check && pnpm --dir app check && pnpm test:site"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "yaml": "^2.9.0"
  }
}
